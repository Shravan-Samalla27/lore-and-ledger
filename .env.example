# Supabase Configuration for Lore & Ledger
# Obtain these values from your Supabase Project Dashboard -> Project Settings -> API

# Project URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Project Publishable Key (safe for client-side queries protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
